<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
        <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Centurion.Models\Centurion.Models.csproj" />
      <ProjectReference Include="..\Centurion.Abstractions\Centurion.Abstractions.csproj" />
      <ProjectReference Include="..\Centurion.Core\Centurion.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Localization\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <Target Name="MoveSatelliteAssemblies" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Release'">
        <ItemGroup>
            <SatelliteAssemblies Include="$(OutputPath)**\*.resources.dll"
                                 Exclude="$(OutputPath)Resources\**;$(OutputPath)win-x64\**" />
            <SatelliteAssembliesToMove Include="@(SatelliteAssemblies)" Condition="Exists('%(FullPath)')" />
        </ItemGroup>
        <Move SourceFiles="@(SatelliteAssembliesToMove)" DestinationFolder="$(OutputPath)Resources\%(RecursiveDir)" />
        <RemoveDir Directories="@(SatelliteAssembliesToMove->'%(RootDir)%(Directory)')" Condition="Exists('%(RootDir)%(Directory)')" />
    </Target>

    <!--
      RapidOcrNet 的内置 PP-OCRv5 模型由包的 build target 只复制到直接引用它的
      Centurion.Core 输出；CLI 作为运行入口也需要 models/v5，这里从 NuGet 包缓存补复制。
    -->
    <Target Name="CopyRapidOcrModels" AfterTargets="AfterBuild" Condition="'$(NuGetPackageRoot)' != ''">
        <ItemGroup>
            <RapidOcrModels Include="$(NuGetPackageRoot)rapidocrnet\4.2.0\models\v5\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(RapidOcrModels)" DestinationFolder="$(OutputPath)models\v5\" SkipUnchangedFiles="true" />
    </Target>

    <PropertyGroup>
        <ApplicationIcon>app.ico</ApplicationIcon>
        <!--
          ReadyToRun（R2R）预编译：仅在发布时显式指定了 RuntimeIdentifier 才默认启用，
          因为 R2R 必须配合运行时包（runtime pack）才能编译；无 RID 时保持关闭，
          避免 NETSDK1094（找不到有效的运行时包）。可用 -p:PublishReadyToRun=false 覆盖。
        -->
        <PublishReadyToRun Condition="'$(PublishReadyToRun)' == '' and '$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    </PropertyGroup>

    <!--
      构建号：以 git HEAD 提交计数作为"第几号构建"，构建后写入输出目录 build-number.txt，
      启动横幅显示 Build #N。发布包可用 -p:CenturionBuildNumber=N 显式覆盖；无 git 时按 0。
    -->
    <Target Name="WriteBuildNumber" AfterTargets="AfterBuild" Condition="Exists('$(OutputPath)Centurion.Cli.dll')">
        <Exec Command="git rev-list --count HEAD" ConsoleToMsBuild="true" IgnoreExitCode="true"
              WorkingDirectory="$(MSBuildProjectDirectory)" StandardOutputImportance="Low">
            <Output TaskParameter="ConsoleOutput" PropertyName="CenturionBuildNumberRaw" />
        </Exec>
        <PropertyGroup>
            <CenturionBuildNumber Condition="'$(CenturionBuildNumber)' == ''">$(CenturionBuildNumberRaw.Trim())</CenturionBuildNumber>
            <CenturionBuildNumber Condition="'$(CenturionBuildNumber)' == ''">0</CenturionBuildNumber>
        </PropertyGroup>
        <WriteLinesToFile File="$(OutputPath)build-number.txt" Lines="$(CenturionBuildNumber)" Overwrite="true" Encoding="ASCII" />
    </Target>

</Project>
