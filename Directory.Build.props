<Project>
  <PropertyGroup>
    <Version>0.5.0</Version>
    <Product>Centurion</Product>
    <Description>A subtitle generation CLI built on a pipeline-operator architecture with on-demand tool/model downloads.</Description>
    <Authors>Centurion Contributors</Authors>
    <RepositoryUrl>https://github.com/Remembering-in-Moskowien/Centurion</RepositoryUrl>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <PropertyGroup>
    <!-- 构建日期（UTC）：更新检查以此判断远端 Release 是否晚于本地构建；发布可用 -p:BuildDate=... 固定 -->
    <BuildDate Condition="'$(BuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</BuildDate>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
  </ItemGroup>
</Project>
